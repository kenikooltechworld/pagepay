# backend/.env.example (app/backend) — copy to .env for local dev; set secrets in Render dashboard for prod.
# --- Runtime / DB ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SECRET_KEY=change-me-dev-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8081
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=exp://localhost:8081

# --- Paystack (use test keys locally; webhook delivered via app/paystack-router Worker pp_ route) ---
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_BANKS_CACHE_TTL_SECONDS=3600
PAYSTACK_HTTP_TIMEOUT_SECONDS=10.0

# --- Auth / Google / Email ---
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
EMAIL_FROM=PagePay <noreply@pagepay.app>

# --- Cloudflare R2 ---
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_S3_API_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_BUCKET=

# --- Firebase ---
FIREBASE_SERVICE_ACCOUNT_FILE=firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Referrals / Welcome (SP, credited on email verification) ---
WELCOME_BONUS_POINTS=1000
REFERRAL_REFERRER_BONUS_SP=100
REFERRAL_REFEREE_BONUS_SP=100

# --- Wallet (SP/CB, pre-Paystack) ---
SP_PER_NAIRA=10
STUDY_UNLOCK_DEFAULT_POINTS=50
# Guard for pre-Paystack grant endpoints (POST /api/v1/wallet/*/grant). Unset/empty => disabled.
WALLET_GRANT_SECRET=change-me-dev-grant-secret
